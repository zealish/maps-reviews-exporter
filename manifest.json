{
  "manifest_version": 3,
  "name": "Google Maps Reviews Exporter: Export Reviews to CSV & Excel",
  "short_name": "Maps Reviews Exporter",
  "version": "0.2.1",
  "description": "Export Google Maps reviews from the place you have open to CSV or Excel. Stars, text, dates, owner replies and photos. Runs locally in your browser, no login, no limits.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["activeTab", "scripting", "downloads"],
  "host_permissions": ["https://www.google.com/*", "https://maps.google.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
